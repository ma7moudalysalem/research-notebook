#!/bin/sh
# ---------------------------------------------------------------------------
# pre-commit - the copyright hard stop, layer two of three.
#
# Three layers, because each of the first two can be stepped over: the trade is
# an extra place to keep in step, in exchange for a rule that holds whichever
# route a file took into the repository.
#
# Layer one is .gitignore, which anyone can edit. Layer three is the CI job in
# .github/workflows/copyright.yml, which runs however the commit was made.
# This layer exists to catch the mistake at the moment it is made, on the
# machine where it is cheapest to fix, and it is the only layer that runs
# BEFORE anything reaches the remote.
#
# It delegates to tools/check_copyright.py rather than reimplementing the
# rules in shell. The previous version did reimplement them, and an audit
# found the two copies had already diverged: the shell was case-insensitive
# where CI was not, CI checked things the shell did not, and one loop in
# both failed OPEN on a filename with a space. One implementation, tested,
# run from two places.
#
# Activate once:  git config core.hooksPath .githooks
# ---------------------------------------------------------------------------
set -e

fail() { printf '\n  COMMIT BLOCKED: %s\n\n' "$1" >&2; exit 1; }

# The guard must be present in BOTH places, and the two are not the same
# question. The working-tree copy is the one this hook is about to run; the
# index copy is the one the commit would ship. `git rm --cached` on the checker
# leaves the file on disk, so a working-tree test alone runs it happily
# and lets through the very commit that removes the guard from the repository.
# LOUD, not silent, either way: the old hook tested for the file and quietly
# skipped when it was absent, which is how a repository ships with a guard
# that asserts nothing while every document says it is guarded.
if [ ! -f tools/check_copyright.py ]; then
  fail "tools/check_copyright.py is missing from the WORKING TREE, so this hook cannot
  check anything. Restore it from main before committing. A guard that is not
  there is not a guard that passed."
fi

if ! git ls-files --error-unmatch tools/check_copyright.py >/dev/null 2>&1; then
  fail "tools/check_copyright.py is on disk but NOT IN THE INDEX, so this commit would
  remove the guard from the repository while the hook ran happily against the
  copy left in your working tree. Run 'git add tools/check_copyright.py'. If you
  really mean to delete the guard, it is a pull request of its own, reviewed as
  such - CI refuses a tree that does not contain it."
fi

PY=python3
command -v python3 >/dev/null 2>&1 || PY=python
command -v "$PY"  >/dev/null 2>&1 || fail "no python interpreter on PATH; the copyright checker needs one."

"$PY" tools/check_copyright.py --staged || fail "the copyright checker refused. Its findings are above.

  Do not reach for --no-verify. The same checker runs in CI on the pull
  request and will refuse there too, in public, with the finding attached."

exit 0
