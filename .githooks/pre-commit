#!/bin/sh
# ---------------------------------------------------------------------------
# pre-commit — the copyright hard stop.
#
# This repository is public and a public repository cannot be un-published: a
# history rewrite does not remove forks, mirrors or caches. Everything below is
# therefore a REFUSAL, and each one is deliberately cheap and dumb — a check
# that needs judgement is a check that is sometimes wrong in the direction that
# publishes something.
#
# This is layer two of three (RD02). Layer one is .gitignore; layer three is a
# required CI status check. Three cheap independent layers mean no single lapse
# of attention is sufficient.
#
# Activate once:  git config core.hooksPath .githooks
# ---------------------------------------------------------------------------
set -e

staged() { git diff --cached --name-only --diff-filter=ACMR; }
fail() { printf '\n  COMMIT BLOCKED: %s\n\n' "$1" >&2; exit 1; }

# --- 1. no third-party PDF, anywhere but my own figures ---------------------
bad_pdf=$(staged | grep -i '\.pdf$' | grep -v '^assets/figures/' || true)
if [ -n "$bad_pdf" ]; then
  fail "a PDF outside assets/figures/ is staged:

$(printf '%s\n' "$bad_pdf" | sed 's/^/    /')

  Publisher PDFs never enter this repository (RD02). They live only in the
  private workspace, which is single-user by design.

  If this is a figure you generated yourself, it belongs under
  assets/figures/ with a .source.yml beside it."
fi

# --- 2. every asset declares its provenance --------------------------------
# A figure with no declared origin is a figure whose origin you will not
# remember in a year, and "I think I drew that one" is not a defence.
for f in $(staged | grep '^assets/figures/' | grep -viE '\.source\.ya?ml$' || true); do
  src="${f%.*}.source.yml"
  if [ ! -f "$src" ] && ! staged | grep -qx "$src"; then
    fail "$f has no $src

  Every figure declares origin: original | redrawn | cc-licensed.
  'original' and 'redrawn' also require the editable source you drew it with
  (.svg, .drawio, .excalidraw, .mmd, or the .py that plots it) — you cannot
  claim you drew something without the thing you drew it with.

  See COPYRIGHT.md#figures."
  fi
done

# --- 3. no notebook outputs -------------------------------------------------
# A rendered cell is the likeliest route for a figure, a data sample or a local
# absolute path to reach a public repository without anyone deciding to publish
# it. Strip with: jupyter nbconvert --clear-output --inplace <file>
for f in $(staged | grep '\.ipynb$' || true); do
  if grep -qE '"(output_type|image/png|image/jpeg)"' "$f" 2>/dev/null; then
    fail "$f carries cell outputs.

  Strip them: jupyter nbconvert --clear-output --inplace \"$f\""
  fi
done

# --- 4. every summary attributes its source --------------------------------
for f in $(staged | grep '^summaries/.*\.md$' || true); do
  [ -f "$f" ] || continue
  if ! grep -q '^## Source and attribution' "$f"; then
    fail "$f has no '## Source and attribution' section.

  Every summary names the work it describes: title, authors, venue, year, and
  a DOI or arXiv link. Without it the summary is unusable by anyone else, and
  it reads as if it were claiming the work."
  fi
done

# --- 5. size -----------------------------------------------------------------
# Far tighter than the private repo's 25 MB. Nothing that belongs here is big,
# so anything big is a mistake rather than a large legitimate file.
for f in $(staged); do
  [ -f "$f" ] || continue
  bytes=$(wc -c < "$f" | tr -d ' ')
  if [ "$bytes" -gt 5242880 ]; then
    fail "$f is $((bytes / 1048576)) MB; the ceiling here is 5 MB.

  Nothing that belongs in a public notebook is this large."
  fi
done

# --- 6. delegate the rest ----------------------------------------------------
# check_copyright.py is a deliberately INDEPENDENT implementation, not a mirror
# of the private repo's promote.py: this is the last line of defence for the
# copyright boundary, and a stale copy of the thing that catches your worst
# mistake is a real risk (RD28). It may not be present yet.
if [ -f tools/check_copyright.py ]; then
  if command -v python >/dev/null 2>&1; then
    python tools/check_copyright.py --staged || fail "check_copyright.py refused."
  fi
fi

exit 0
