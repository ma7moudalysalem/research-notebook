{
  // Shared with the public repo; parity is asserted in CI so a note that
  // validates privately cannot fail after promotion.
  "config": {
    "default": true,

    // MD013 line-length: OFF. Hard-wrapping fights Obsidian's editor and makes
    // every prose edit a multi-line diff. Readability is the editor's job.
    "MD013": false,

    // MD024 duplicate headings: siblings only. Every paper note has "## Method"
    // and "## Results"; that is the template working, not an error.
    "MD024": { "siblings_only": true },

    // MD033 inline HTML: allowed for the AUTO markers and detail blocks.
    "MD033": { "allowed_elements": ["details", "summary", "br", "sub", "sup", "kbd", "img"] },

    // MD041 first line must be a top-level heading: ON. Frontmatter is skipped.
    "MD041": true,

    // MD025 counts the frontmatter `title:` as a heading by default, so every
    // note in this repository reads as having two H1s: the property Obsidian
    // shows, and the `# Title` GitHub renders. Both are wanted. Setting
    // front_matter_title to empty disables the frontmatter half of the check
    // and leaves the real one - two `#` headings in one document - enforced.
    "MD025": { "front_matter_title": "" },

    // MD029 ordered list numbering: one style, so diffs stay small.
    "MD029": { "style": "ordered" },

    // MD060 table column alignment: OFF. It is not in the version CI pins, and
    // enabling it reports 453 findings about pipe padding - cosmetic, uniform,
    // and exactly the volume that buries a real finding when someone later
    // bumps the action.
    "MD060": false,

    // MD046 code block style: fenced everywhere.
    "MD046": { "style": "fenced" }
  },
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    ".venv/**",
    "writing/thesis/**",       // LaTeX-adjacent scratch prose
    "**/AUTO-*.md",
    // Issue and PR templates open with an HTML comment on purpose: the comment
    // is instruction to the person filling the form and must not render.
    ".github/**"
  ]
}
